{
  "systems": {
    "citymove": {
      "api_url": "http://city_move:8000/test",
      "schema": "staging",
      "tables": {
        "linien": {
          "target_table": "cm_linie",
          "id_parameter": "linie_id",
          "columns": [
            "id",
            "liniennummer",
            "bezeichnung",
            "verkehrsmittel",
            "gueltig_ab",
            "gueltig_bis"
          ]
        },
        "haltestellen": {
          "target_table": "cm_haltestelle",
          "id_parameter": "haltestelle_id",
          "columns": [
            "id",
            "name",
            "stadtteil",
            "latitude",
            "longitude"
          ]
        },
        "fahrzeuge": {
          "target_table": "cm_fahrzeug",
          "id_parameter": "fahrzeug_id",
          "columns": [
            "id", 
            "kapazitaet"
          ]
        },
        "fahrten": {
          "target_table": "cm_fahrt",
          "id_parameter": "fahrt_id",
          "columns": [
            "id",
            "id_linie",
            "id_fahrzeug",
            "datum",
            "fahrtrichtung"
          ]
        },
        "fahrplaene": {
          "target_table": "cm_fahrplan",
          "id_parameter": "fahrplan_id",
          "columns": [
            "id", 
            "id_fahrt",
            "id_haltestelle",
            "ankunft_geplant",
            "abfahrt_geplant"
