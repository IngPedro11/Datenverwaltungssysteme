            "id",
            "id_fahrt",
            "id_haltestelle",
            "ankunft_tatsaechlich",
            "abfahrt_tatsaechlich"
          ]
        },
        "fahrgastaufkommen": {
          "target_table": "cm_fahrgastaufkommen",
          "id_parameter": "fahrgastaufkommen_id",
          "columns": [
            "id",
            "id_fahrt",
            "id_haltestelle",
            "einsteiger",
            "aussteiger"
          ]
        }
      }
    },
